<Window x:Class="MomoBackend.Views.MainConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Momo 配置管理" Height="900" Width="780"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Window.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5,5,5,0"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#90EE90"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#ADD8E6"/>
        </Style>
        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#FFFACD"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 目标窗口配置 -->
        <GroupBox Grid.Row="0" Header="目标窗口配置" Style="{StaticResource GroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="选择窗口:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="WindowComboBox" Grid.Row="0" Grid.Column="1"
                          SelectionChanged="WindowComboBox_SelectionChanged" Margin="0,4"/>
                <Button Grid.Row="0" Grid.Column="2" Content="刷新" Click="RefreshWindows_Click"
                        Style="{StaticResource ButtonStyle}" Width="60"/>
                <Button Grid.Row="0" Grid.Column="3" Content="应用" Click="ApplyWindow_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Width="60"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="窗口标题:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TargetTitleText" Width="280" IsReadOnly="True" Margin="0,0,20,0"/>
                    <TextBlock Text="进程名:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TargetProcessText" Width="200" IsReadOnly="True"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 点击区域配置 -->
        <GroupBox Grid.Row="1" Header="点击区域配置" Style="{StaticResource GroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="ClickPointsDataGrid" Grid.Column="0" Height="130"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="All" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="别名" Binding="{Binding Alias}" Width="120"/>
                        <DataGridTextColumn Header="X" Binding="{Binding X}" Width="60"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="60"/>
                        <DataGridTextColumn Header="点击模式" Binding="{Binding ClickMode}" Width="120"/>
                        <DataGridTextColumn Header="按键" Binding="{Binding Button}" Width="60"/>
                        <DataGridCheckBoxColumn Header="自动OCR" Binding="{Binding AutoRefreshOcr}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Button Content="添加" Click="AddPoint_Click" Style="{StaticResource ButtonStyle}"/>
                    <Button Content="编辑" Click="EditPoint_Click" Style="{StaticResource ButtonStyle}"/>
                    <Button Content="删除" Click="DeletePoint_Click" Style="{StaticResource ButtonStyle}"/>
                    <Button Content="框选捕获" Click="CapturePoint_Click" Style="{StaticResource WarningButtonStyle}"/>
                    <Button Content="预览位置" Click="PreviewRegions_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- OCR 区域配置 -->
        <GroupBox Grid.Row="2" Header="OCR 识别区域配置" Style="{StaticResource GroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="OcrRegionsDataGrid" Grid.Row="0" Grid.Column="0" Height="100"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="All" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="别名" Binding="{Binding Alias}" Width="100"/>
                        <DataGridTextColumn Header="X" Binding="{Binding X}" Width="50"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="50"/>
                        <DataGridTextColumn Header="宽" Binding="{Binding Width}" Width="50"/>
                        <DataGridTextColumn Header="高" Binding="{Binding Height}" Width="50"/>
                        <DataGridTextColumn Header="语言" Binding="{Binding LanguageDisplay}" Width="60"/>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                    <Button Content="添加" Click="AddOcrRegion_Click" Style="{StaticResource ButtonStyle}"/>
                    <Button Content="编辑" Click="EditOcrRegion_Click" Style="{StaticResource ButtonStyle}"/>
                    <Button Content="删除" Click="DeleteOcrRegion_Click" Style="{StaticResource ButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="框选捕获" Click="CaptureOcrRegion_Click" Style="{StaticResource WarningButtonStyle}"/>
                    <Button Content="预览区域" Click="PreviewRegions_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    <TextBlock Text="间隔(秒):" VerticalAlignment="Center" Margin="20,0,8,0"/>
                    <TextBox x:Name="OcrRefreshIntervalText" Width="50" VerticalAlignment="Center" Text="3"/>
                    <CheckBox x:Name="OcrAutoRefreshCheck" Content="自动刷新" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock Text="OCR引擎:" VerticalAlignment="Center" Margin="20,0,8,0"/>
                    <ComboBox x:Name="OcrEngineCombo" Width="140" VerticalAlignment="Center">
                        <ComboBoxItem Content="PaddleOCR (推荐)" IsSelected="True"/>
                        <ComboBoxItem Content="Windows OCR"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 后台点击参数配置 -->
        <GroupBox Grid.Row="3" Header="后台点击参数 (fast_background)" Style="{StaticResource GroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行参数 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="窗口透明度:" VerticalAlignment="Center" Width="80"
                               ToolTip="点击时目标窗口的透明度 (0-255)&#x0a;0 = 完全透明&#x0a;255 = 完全不透明&#x0a;建议值: 1-10"/>
                    <TextBox x:Name="FbAlphaText" Width="50" Text="3" ToolTip="点击时目标窗口的透明度 (0-255)"/>

                    <TextBlock Text="恢复后(ms):" VerticalAlignment="Center" Width="80" Margin="20,0,0,0"
                               ToolTip="窗口从最小化恢复后的等待时间"/>
                    <TextBox x:Name="FbDelayAfterRestoreText" Width="50" Text="30"/>

                    <TextBlock Text="激活后(ms):" VerticalAlignment="Center" Width="80" Margin="20,0,0,0"
                               ToolTip="窗口激活后的等待时间"/>
                    <TextBox x:Name="FbDelayBeforeClickText" Width="50" Text="20"/>

                    <TextBlock Text="移动后(ms):" VerticalAlignment="Center" Width="80" Margin="20,0,0,0"
                               ToolTip="鼠标移动到目标位置后的等待时间"/>
                    <TextBox x:Name="FbDelayAfterMoveText" Width="50" Text="10"/>
                </StackPanel>

                <!-- 第二行参数 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="点击后(ms):" VerticalAlignment="Center" Width="80"
                               ToolTip="点击完成后的等待时间"/>
                    <TextBox x:Name="FbDelayAfterClickText" Width="50" Text="30"/>

                    <TextBlock Text="切换前(ms):" VerticalAlignment="Center" Width="80" Margin="20,0,0,0"
                               ToolTip="切换回原窗口前的等待时间"/>
                    <TextBox x:Name="FbDelayBeforeRestoreText" Width="50" Text="20"/>

                    <CheckBox x:Name="FbMinimizeAfterClickCheck" Content="点击后最小化窗口"
                              VerticalAlignment="Center" Margin="30,0,0,0" IsChecked="True"
                              ToolTip="点击完成后是否将目标窗口最小化"/>
                    <CheckBox x:Name="FbHideCursorCheck" Content="隐藏鼠标光标"
                              VerticalAlignment="Center" Margin="20,0,0,0" IsChecked="True"
                              ToolTip="点击时是否隐藏鼠标光标"/>
                </StackPanel>

                <!-- 说明 -->
                <TextBlock Grid.Row="2" Margin="0,8,0,2" Foreground="DarkBlue" TextWrapping="Wrap"
                           Text="【点击流程】恢复窗口 → 设置透明 → 等待(恢复后) → 激活窗口 → 等待(激活后) → 移动鼠标 → 等待(移动后) → 点击 → 等待(点击后) → 恢复鼠标 → 等待(切换前) → 切换窗口"/>
                <TextBlock Grid.Row="3" Foreground="Gray" TextWrapping="Wrap"
                           Text="【调试建议】如果点击不稳定: 1) 先增加&quot;激活后&quot;延迟到 50-100ms  2) 再增加&quot;点击后&quot;延迟  3) 透明度建议 1-10"/>
                <TextBlock Grid.Row="4" Foreground="Gray" TextWrapping="Wrap"
                           Text="【注意】总延迟 = 恢复后 + 激活后 + 移动后 + 点击后 + 切换前，延迟越长点击越稳定但速度越慢"/>
            </Grid>
        </GroupBox>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="5,10,5,5">
            <Button Content="保存配置" Click="SaveConfig_Click" Style="{StaticResource PrimaryButtonStyle}" Width="100"/>
            <Button Content="重新加载" Click="LoadConfig_Click" Style="{StaticResource ButtonStyle}" Width="100"/>
            <Button Content="导出配置" Click="ExportConfig_Click" Style="{StaticResource ButtonStyle}" Width="100"/>
            <Button Content="导入配置" Click="ImportConfig_Click" Style="{StaticResource ButtonStyle}" Width="100"/>
            <Button Content="打开测试窗口" Click="OpenTestWindow_Click" Style="{StaticResource SecondaryButtonStyle}" Width="120"/>
        </StackPanel>

        <!-- 配置文件路径 -->
        <TextBlock x:Name="ConfigPathLabel" Grid.Row="5" Margin="10,0,10,5" Foreground="Gray" FontSize="11"/>

        <!-- 可折叠日志面板 -->
        <Expander Grid.Row="6" Header="日志" IsExpanded="False" Margin="5,0,5,5">
            <TextBox x:Name="LogTextBox" Height="150" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"/>
        </Expander>
    </Grid>
</Window>
