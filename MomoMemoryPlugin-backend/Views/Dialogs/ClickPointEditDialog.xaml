<Window x:Class="MomoBackend.Views.Dialogs.ClickPointEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑点击区域" Height="320" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="别名:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="AliasText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="X 坐标:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="XInput" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Y 坐标:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="YInput" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="点击模式:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox x:Name="ModeCombo" Grid.Row="3" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,8">
            <ComboBoxItem Content="fast_background"/>
            <ComboBoxItem Content="hidden_cursor"/>
            <ComboBoxItem Content="foreground"/>
        </ComboBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="按键:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox x:Name="ButtonCombo" Grid.Row="4" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,8">
            <ComboBoxItem Content="left"/>
            <ComboBoxItem Content="right"/>
        </ComboBox>

        <CheckBox x:Name="AutoRefreshOcrCheck" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="点击后自动刷新OCR区域" Margin="0,8,0,4"
                  Checked="AutoRefreshOcrCheck_Changed" Unchecked="AutoRefreshOcrCheck_Changed"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    x:Name="DelayPanel" Margin="20,0,0,0">
            <TextBlock Text="刷新延时:" VerticalAlignment="Center"/>
            <TextBox x:Name="DelayInput" Width="80" Margin="8,0,8,0" Text="500"/>
            <TextBlock Text="毫秒" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="确定" Width="80" Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
