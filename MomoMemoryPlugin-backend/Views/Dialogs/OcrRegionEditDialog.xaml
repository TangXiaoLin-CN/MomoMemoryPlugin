<Window x:Class="MomoBackend.Views.Dialogs.OcrRegionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑 OCR 区域" Height="340" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="别名:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="AliasText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="XInput" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Y:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="YInput" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="宽度:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="WidthInput" Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="高度:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="HeightInput" Grid.Row="4" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="语言:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox x:Name="LangCombo" Width="100">
                <ComboBoxItem Content="自动" IsSelected="True"/>
                <ComboBoxItem Content="中文"/>
                <ComboBoxItem Content="英文"/>
            </ComboBox>
            <CheckBox x:Name="EnabledCheck" Content="启用" VerticalAlignment="Center" Margin="20,0,0,0" IsChecked="True"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="确定" Width="80" Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
