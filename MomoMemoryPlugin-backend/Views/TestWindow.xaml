<Window x:Class="MomoBackend.Views.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="测试窗口" Height="700" Width="750"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize">
    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#90EE90"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#ADD8E6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 目标窗口信息 -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10,8">
            <TextBlock x:Name="WindowInfoLabel" FontWeight="Bold" FontSize="13"/>
        </Border>

        <!-- TabControl -->
        <TabControl Grid.Row="1" Margin="5">
            <!-- 点击测试标签页 -->
            <TabItem Header="点击测试">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 手动点击测试 -->
                    <GroupBox Grid.Row="0" Header="手动点击测试" Margin="0,0,0,10">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 坐标输入 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="X 坐标:" VerticalAlignment="Center" Width="55"/>
                                <TextBox x:Name="XInput" Width="80" Text="0" Margin="0,0,20,0"/>
                                <TextBlock Text="Y 坐标:" VerticalAlignment="Center" Width="55"/>
                                <TextBox x:Name="YInput" Width="80" Text="0"/>
                            </StackPanel>

                            <!-- 点击模式 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="点击模式:" VerticalAlignment="Center" Width="55"/>
                                <ComboBox x:Name="ModeComboBox" Width="200" SelectedIndex="0">
                                    <ComboBoxItem Content="fast_background (后台点击)"/>
                                    <ComboBoxItem Content="hidden_cursor (隐藏光标)"/>
                                    <ComboBoxItem Content="foreground (前台点击)"/>
                                </ComboBox>
                                <TextBlock Text="按键:" VerticalAlignment="Center" Width="40" Margin="20,0,0,0"/>
                                <ComboBox x:Name="ButtonComboBox" Width="100" SelectedIndex="0">
                                    <ComboBoxItem Content="left (左键)"/>
                                    <ComboBoxItem Content="right (右键)"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 操作按钮和鼠标位置 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="捕获鼠标位置 (3秒后)" Click="CapturePosition_Click"
                                        Style="{StaticResource ButtonStyle}" Width="150"/>
                                <Button Content="执行点击" Click="ExecuteClick_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Width="100"/>
                                <TextBlock x:Name="MousePositionLabel" VerticalAlignment="Center"
                                           Margin="20,0,0,0" Foreground="DarkGreen"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- 配置点击测试 -->
                    <GroupBox Grid.Row="1" Header="配置点击测试" Margin="0,0,0,10">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <DataGrid x:Name="ClickTestDataGrid" Grid.Column="0" Height="120"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      SelectionMode="Single" GridLinesVisibility="All" HeadersVisibility="Column"
                                      MouseDoubleClick="ClickTestDataGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="别名" Binding="{Binding Alias}" Width="150"/>
                                    <DataGridTextColumn Header="坐标" Binding="{Binding CoordDisplay}" Width="100"/>
                                    <DataGridTextColumn Header="模式" Binding="{Binding ClickMode}" Width="120"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button Content="测试选中" Click="TestSelectedClick_Click"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Content="测试全部" Click="TestAllClicks_Click"
                                        Style="{StaticResource ButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <TextBlock Grid.Row="2" Text="提示: 双击列表项可快速测试单个点击区域"
                               Foreground="Gray" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>

            <!-- OCR 测试标签页 -->
            <TabItem Header="OCR 测试">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="OcrTestDataGrid" Grid.Row="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="All" HeadersVisibility="Column"
                              MouseDoubleClick="OcrTestDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="别名" Binding="{Binding Alias}" Width="100"/>
                            <DataGridTextColumn Header="区域" Binding="{Binding RegionDisplay}" Width="150"/>
                            <DataGridTextColumn Header="识别结果" Binding="{Binding Result}" Width="*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="识别选中" Click="TestSelectedOcr_Click"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="识别全部" Click="TestAllOcr_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <CheckBox x:Name="AutoRefreshCheck" Content="自动刷新"
                                  VerticalAlignment="Center" Margin="20,0,0,0"
                                  Checked="AutoRefreshCheck_Changed" Unchecked="AutoRefreshCheck_Changed"/>
                        <TextBlock x:Name="RefreshIntervalLabel" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="Gray"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 日志面板 -->
        <Expander Grid.Row="2" Header="日志" IsExpanded="True" Margin="5,0,5,5">
            <TextBox x:Name="LogTextBox" Height="150" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"/>
        </Expander>
    </Grid>
</Window>
